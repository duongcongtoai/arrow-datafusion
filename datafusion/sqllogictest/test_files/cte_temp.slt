set datafusion.execution.enable_recursive_ctes = true;

query TT
explain select * from t1 where t1.b = (
    with recursive tree_branch as (
         select t2.a, t2.b as parent_id,t2.c as t1_ref, 1 as level from t2
         union all
         select t2.a, t2.b as parent_id ,tree_branch.t1_ref ,tree_branch.level+1 from tree_branch left join 
         t2 on t2.a = tree_branch.parent_id
     ) 
     select count(*) from tree_branch where parent_id is null
     and t1_ref = t1.a
); 
----
